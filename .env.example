# Variables de entorno para Argos
# ─────────────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores
# ─────────────────────────────────────────────────────

# Proveedor de IA por defecto: "openai" (recomendado) o "gemini"
AI_PROVIDER=openai

# API Key de OpenAI (obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY=tu_openai_key_aqui
OPENAI_MODEL=gpt-4o-mini

# Tope Máximo de Gasto Mensual en USD (Protección de Presupuesto)
MAX_MONTHLY_AI_BUDGET_USD=5.00

# API Key de Google Gemini (opcional / fallback gratis)
GEMINI_API_KEY=tu_api_key_aqui

